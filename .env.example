# ==============================================================================
# SIJAGO BACKEND (Express.js + Drizzle ORM + PostGIS) — ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env` lalu isi nilainya secara manual.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & APPLICATION CONFIG
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/v1

# URL Frontend (Next.js) untuk konfigurasi CORS & pembuatan tautan pelacakan/magic link
FRONTEND_URL=http://localhost:3000
# Additional frontend origins, separated by commas. Development also allows local ports 3000/3001.
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. DATABASE (Neon PostgreSQL Free Tier + PostGIS)
# Pastikan ekstensi `postgis` dan `pgcrypto` diaktifkan di database ini.
# ------------------------------------------------------------------------------
# Connection string pooled (untuk aplikasi runtime)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Connection string direct/unpooled (opsional, untuk migrasi drizzle-kit jika dibutuhkan)
DIRECT_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SECURITY & HASHING
# ------------------------------------------------------------------------------
# Gunakan string acak minimal 32 karakter (contoh: `openssl rand -hex 32`)
JWT_SECRET="ganti_dengan_secret_key_jwt_minimal_32_karakter_acak"
JWT_EXPIRES_IN="7d"
SESSION_TTL_HOURS=8

# Salt rahasia untuk menghasilkan hash pseudonim perangkat warga & hash IP di audit log
PSEUDONYM_HASH_SALT="ganti_dengan_salt_rahasia_untuk_privasi_warga_sijago"

# ------------------------------------------------------------------------------
# 4. AI DRAFT ASSISTANT (OpenAI `gpt-6-luna` — Reasoning Medium)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-6-luna"
OPENAI_REASONING_EFFORT="medium"
# Timeout panggilan AI dalam milidetik sebelum otomatis jatuh ke Draf Template (default: 9000 ms)
AI_TIMEOUT_MS=9000
# Feature flag cepat: set ke "false" jika ingin memaksa semua draf memakai Draf Template
AI_DRAFT_ENABLED=true

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE FOTO (Cloudinary Free Tier)
# Digunakan untuk menyimpan foto asli (Admin) & varian publik tanpa EXIF / Blur
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_UPLOAD_FOLDER="sijago-mia2026"

# ------------------------------------------------------------------------------
# 6. TRANSAKSI EMAIL & ESKALASI INSTANSI (Resend Free Tier)
# Catatan Free Tier Resend: Jika belum verifikasi domain kustom, gunakan
# `onboarding@resend.dev` dan pastikan email penerima simulasi sudah terdaftar.
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="SIJAGO Kota Bogor <onboarding@resend.dev>"
# Secret untuk memverifikasi webhook status pengiriman (DELIVERED / BOUNCED) dari Resend (opsional saat dev)
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_secret"

# Email default untuk simulasi penerimaan eskalasi instansi saat pengujian/demo MIA2026
SIMULATED_AGENCY_DEFAULT_EMAIL="email.anda.untuk.demo@gmail.com"

# ------------------------------------------------------------------------------
# 7. ANTI-BOT / CAPTCHA (Cloudflare Turnstile Free)
# Gunakan Dummy Secret Key Cloudflare `1x0000000000000000000000000000000AA` untuk testing lokal
# ------------------------------------------------------------------------------
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 8. GEOCODING & WEATHER-ROAD INTELLIGENCE (API Cuaca Gratis — F9)
# ------------------------------------------------------------------------------
# Wajib disertakan saat memanggil Nominatim OpenStreetMap & BMKG Open Data
OSM_NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
APP_USER_AGENT="SIJAGO-MIA2026/1.0 (Sistem Jalan Bogor; contact@sijago.simulasi.id)"

# Sumber Utama Data Cuaca: "OPEN_METEO_AND_BMKG" (100% Gratis tanpa API Key)
WEATHER_PRIMARY_PROVIDER="OPEN_METEO_AND_BMKG"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
BMKG_API_BASE_URL="https://api.bmkg.go.id/publik"
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"

# Opsional: Isi jika nanti ingin mencoba penyedia cuaca cadangan yang memakai API Key
OPENWEATHER_API_KEY=""
WEATHERAPI_KEY=""
VISUALCROSSING_API_KEY=""
